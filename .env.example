# ============================================================================
#  Sync — copy this file to .env and fill it in.  (.env is gitignored)
# ============================================================================

# Your public domain, without scheme. Used by the bundled Caddy AND to derive
# the backend base URL, the OAuth redirect URIs and CORS. Example:
DOMAIN=sync.example.com

# Session-cookie + OAuth-state signing secret. Generate with:
#   openssl rand -hex 32
APP_SECRET=

# --- Google OAuth (one client for both login and calendar access) ----------
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# (OAuth client, type "Web application"). Enable the Google Calendar API.
# Register these Authorized redirect URIs (replace with your DOMAIN):
#   https://sync.example.com/api/auth/google/callback
#   https://sync.example.com/calendar/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Fernet key encrypting the stored Google tokens at rest. NEVER commit it.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Restrict login to ONE Google Workspace domain (e.g. yourcompany.com).
# Leave EMPTY to allow any verified Google account (personal / single-user).
ALLOWED_EMAIL_DOMAIN=

# This address becomes admin on login. Leave EMPTY to make the very first
# user who signs in the admin.
INITIAL_ADMIN_EMAIL=

# --- Optional: e-mail via Brevo (reconnect notice). Empty = e-mail off. -----
BREVO_API_KEY=
BREVO_FROM_NAME=Sync
BREVO_FROM_EMAIL=

# --- Optional: sync engine tuning -------------------------------------------
# SYNC_POLL_INTERVAL_MINUTES=3      # how often the automatic sync runs
# SYNC_WRITE_PAUSE_MS=60            # pause after each Google write (rate limits)
# SYNC_BACKFILL_DAYS=30            # how far back the first sync reaches

# ============================================================================
#  Only for docker-compose.prod.yml (behind an EXISTING reverse proxy).
#  The default docker-compose.yml derives these from DOMAIN automatically.
# ============================================================================
# APP_BASE_URL=https://sync.example.com
# DATABASE_URL=sqlite:////app/data/sync.db
# COOKIE_SECURE=true

# ============================================================================
#  Local development (do NOT set in production)
# ============================================================================
# APP_BASE_URL=http://localhost:5173
# COOKIE_SECURE=false
# DATABASE_URL=sqlite:///./data/sync.db
