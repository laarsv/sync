# --- Sync (sync.vrwb.de): Beispiel-Env. Kopieren nach .env (gitignored). ---

# SQLite im Container (Volume-Mount, siehe docker-compose.prod.yml).
DATABASE_URL=sqlite:////app/data/sync.db

# Session-Cookie- + OAuth-state-Signatur. NIE manuell tippen:
#   openssl rand -hex 32
APP_SECRET=
# Prod: True (HTTPS). Lokal ueber http://localhost auf False setzen.
COOKIE_SECURE=true

# --- Google OAuth (ein Client fuer Login + Calendar, App-Typ "Internal") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Zwei Redirect-URIs im Google-Cloud-Client eintragen:
GOOGLE_OAUTH_REDIRECT_URI=https://sync.vrwb.de/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://sync.vrwb.de/calendar/callback

# Fernet-Key fuer Token-Verschluesselung at-rest. NIE committen. Generieren:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Login/Consent nur fuer diese Workspace-Domain.
ALLOWED_EMAIL_DOMAIN=koenigswege.com
# Diese Adresse wird beim ersten Login automatisch Admin.
INITIAL_ADMIN_EMAIL=lars.verwiebe@koenigswege.com

CORS_ORIGINS=https://sync.vrwb.de
APP_BASE_URL=https://sync.vrwb.de

# --- Sync-Engine ---
SYNC_POLL_INTERVAL_MINUTES=3
SYNC_BACKFILL_DAYS=30
SYNC_FULL_RESYNC_HOURS=24

# --- NUR LOKAL (in Prod NICHT setzen) ---
# DATABASE_URL=sqlite:///./data/sync.db
# COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:5173
